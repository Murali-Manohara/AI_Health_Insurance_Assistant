# ==========================================
# Chroma Cloud & Remote Settings
# ==========================================
# Enter your Chroma Cloud API Key and Tenant/Database below:
CHROMA_MODE=cloud
CHROMA_API_KEY=your_chroma_cloud_api_key_here
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_CLOUD_HOST=api.trychroma.com
CHROMA_CLOUD_PORT=443

# Alternative: Remote Self-Hosted Chroma HTTP Server
CHROMA_SERVER_HOST=
CHROMA_SERVER_PORT=8000
CHROMA_SERVER_SSL=true
CHROMA_SERVER_AUTH_TOKEN=

# ==========================================
# Embedding & Chunking Configuration
# ==========================================
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
MAX_UPLOAD_SIZE_BYTES=26214400
TARGET_CHUNK_TOKENS_MIN=450
TARGET_CHUNK_TOKENS_MAX=550
CHUNK_OVERLAP_TOKENS=80
